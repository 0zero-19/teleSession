<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="badge_current_bg">#20FFFFFF</color>
    <color name="badge_current_text">#FFFFFF</color>
    <color name="badge_official_bg">#14FFFFFF</color>
    <color name="badge_official_text">#D4D4D4</color>
    <color name="bg_card">#12FFFFFF</color>
    <color name="bg_card_highlight">#1EFFFFFF</color>
    <color name="bg_dark">#000000</color>
    <color name="bg_input">#14FFFFFF</color>
    <color name="black">#000000</color>
    <color name="border_dark">#26FFFFFF</color>
    <color name="color_danger">#FFFFFF</color>
    <color name="color_danger_bg">#1FFFFFFF</color>
    <color name="color_danger_hover">#E5E5E5</color>
    <color name="color_success">#FFFFFF</color>
    <color name="color_warning">#D4D4D4</color>
    <color name="glass_bg_black">#000000</color>
    <color name="glass_bg_deep">#0D0D0D</color>
    <color name="glass_stroke_active">#FFFFFFFF</color>
    <color name="glass_stroke_medium">#38FFFFFF</color>
    <color name="glass_stroke_strong">#66FFFFFF</color>
    <color name="glass_stroke_subtle">#1FFFFFFF</color>
    <color name="glass_surface_1">#12FFFFFF</color>
    <color name="glass_surface_2">#1AFFFFFF</color>
    <color name="glass_surface_3">#26FFFFFF</color>
    <color name="glass_surface_dialog">#141414</color>
    <color name="mono_text_muted">#737373</color>
    <color name="mono_text_primary">#FFFFFF</color>
    <color name="mono_text_secondary">#B3B3B3</color>
    <color name="text_muted">#737373</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B3B3B3</color>
    <color name="tg_blue">#FFFFFF</color>
    <color name="tg_blue_dark">#CCCCCC</color>
    <color name="tg_blue_glow">#26FFFFFF</color>
    <color name="transparent">#00000000</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Telegram Sessions</string>
    <style name="ModalBottomSheetDialogStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@color/glass_bg_deep</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.GlassBottomSheet</item>
    </style>
    <style name="ShapeAppearance.GlassBottomSheet" parent="">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
    <style name="ShapeAppearance.GlassDialog" parent="">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Theme.TelegramSessionManager" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/glass_bg_black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorAccent">@color/white</item>
        <item name="android:windowBackground">@color/glass_bg_black</item>
        <item name="android:statusBarColor">@color/glass_bg_black</item>
        <item name="android:navigationBarColor">@color/glass_bg_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/mono_text_secondary</item>
        <item name="materialAlertDialogTheme">@style/Theme.TelegramSessionManager.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.TelegramSessionManager.BottomSheet</item>
    </style>
    <style name="Theme.TelegramSessionManager.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialogStyle</item>
    </style>
    <style name="Theme.TelegramSessionManager.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/glass_surface_dialog</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.GlassDialog</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
    </style>
</resources>